+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 John Knipper
+//! Cross-thread wakeup using native Rust synchronization, without a pipe fd.
+use std::{io, os::fd::RawFd, sync::{Condvar, Mutex}, time::Duration};
+#[derive(Debug)]
+pub(crate) struct Waker { pending: Mutex<bool>, signal: Condvar }
+impl Waker {
+    pub(crate) fn new_unregistered() -> io::Result<Self> {
+        Ok(Self { pending: Mutex::new(false), signal: Condvar::new() })
+    }
+    pub(crate) fn wake(&self) -> io::Result<()> {
+        *self.pending.lock().unwrap() = true;
+        self.signal.notify_all();
+        Ok(())
+    }
+    pub(crate) fn fd(&self) -> Option<RawFd> { None }
+    pub(crate) fn woken(&self) -> bool { *self.pending.lock().unwrap() }
+    pub(crate) fn ack_and_reset(&self) { *self.pending.lock().unwrap() = false; }
+    pub(crate) fn wait_for(&self, timeout: Duration) {
+        let pending = self.pending.lock().unwrap();
+        if !*pending { drop(self.signal.wait_timeout(pending, timeout).unwrap()); }
+    }
+}
