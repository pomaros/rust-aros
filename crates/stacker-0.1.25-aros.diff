+++ b/src/backends/aros.rs	2026-10-25 02:31:06
@@ -0,0 +1,61 @@
+//! AROS: an exec task's stack is the range `tc_SPLower..tc_SPUpper`, and the
+//! kernel suspends a task whose stack pointer is outside it at a task switch.
+//! A new stack is therefore entered with exec's `NewStackSwap()`, which moves
+//! those bounds along, through the platform adapter of the AROS toolchain.
+
+use std::ffi::c_void;
+
+extern "C" {
+    fn aros_rs_stack_lower() -> *mut c_void;
+    fn aros_rs_call_on_stack(
+        lower: *mut c_void,
+        size: usize,
+        entry: unsafe extern "C" fn(*mut c_void),
+        arg: *mut c_void,
+    );
+}
+
+pub unsafe fn guess_os_stack_limit() -> Option<usize> {
+    Some(aros_rs_stack_lower() as usize)
+}
+
+const ALIGNMENT: usize = 16;
+
+struct Call<'a> {
+    callback: &'a mut dyn FnMut(),
+    panic: Option<Box<dyn std::any::Any + Send>>,
+}
+
+unsafe extern "C" fn entry(arg: *mut c_void) {
+    let call = &mut *(arg as *mut Call<'_>);
+    let callback = &mut call.callback;
+    call.panic = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| callback())).err();
+}
+
+pub fn _grow(stack_size: usize, callback: &mut dyn FnMut()) {
+    let stack_size = stack_size
+        .checked_add(ALIGNMENT - 1)
+        .expect("unreasonably large stack requested")
+        / ALIGNMENT
+        * ALIGNMENT;
+    let layout = std::alloc::Layout::from_size_align(stack_size, ALIGNMENT).unwrap();
+    let stack = unsafe { std::alloc::alloc(layout) };
+    assert!(!stack.is_null(), "unable to allocate stack");
+
+    let old_limit = crate::get_stack_limit();
+    crate::set_stack_limit(Some(stack as usize));
+    let mut call = Call { callback, panic: None };
+    unsafe {
+        aros_rs_call_on_stack(
+            stack.cast(),
+            stack_size,
+            entry,
+            (&mut call as *mut Call<'_>).cast(),
+        );
+    }
+    crate::set_stack_limit(old_limit);
+    unsafe { std::alloc::dealloc(stack, layout) };
+    if let Some(panic) = call.panic {
+        std::panic::resume_unwind(panic);
+    }
+}
