@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 John Knipper
+//! AROS CRT signal callbacks run synchronously in task context. Wake each live
+//! reactor through its existing native Mio waker, rather than a Unix socket.
+//! This must not be selected for platforms with asynchronous POSIX handlers.
+use std::{
+    io,
+    sync::{Arc, Mutex, Weak},
+};
+
+#[derive(Debug, Default)]
+pub(crate) struct Notifications {
+    reactors: Mutex<Vec<Weak<Reactor>>>,
+}
+
+#[derive(Debug)]
+pub(crate) struct Subscription {
+    owner: &'static Notifications,
+    reactor: Arc<Reactor>,
+}
+
+#[derive(Debug)]
+struct Reactor {
+    waker: Arc<mio::Waker>,
+}
+
+impl Notifications {
+    pub(crate) fn subscribe(&'static self, waker: Arc<mio::Waker>) -> Subscription {
+        let reactor = Arc::new(Reactor { waker });
+        self.reactors.lock().unwrap().push(Arc::downgrade(&reactor));
+        Subscription {
+            owner: self,
+            reactor,
+        }
+    }
+
+    pub(crate) fn notify(&self) {
+        // The callback records its atomic event flag before waking reactors.
+        // Holding this lock serializes notification against subscription/drop;
+        // Mio does not call back into this registry while waking its selector.
+        for reactor in self.reactors.lock().unwrap().iter() {
+            if let Some(reactor) = reactor.upgrade() {
+                // A wake is advisory: the recorded event remains pending even
+                // if the reactor is already closing.
+                let _: io::Result<()> = reactor.waker.wake();
+            }
+        }
+    }
+}
+
+impl Drop for Subscription {
+    fn drop(&mut self) {
+        let key = Arc::downgrade(&self.reactor);
+        self.owner
+            .reactors
+            .lock()
+            .unwrap()
+            .retain(|entry| !entry.ptr_eq(&key));
+    }
+}
